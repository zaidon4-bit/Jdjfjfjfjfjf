# Required: use a persistent PostgreSQL database (Neon, Render PostgreSQL, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
NODE_ENV=production
PORT=4000

# Generate a random secret with at least 32 characters; never commit real values.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL=7d

# Create the first admin account. Use a unique username and a strong password (12+ chars).
ADMIN_USERNAME=your-admin-name
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Set true for a single deployment to rotate an existing admin password, then set false again.
ADMIN_FORCE_PASSWORD_RESET=false

# Multiple Gemini keys: comma or newline separated. Keep these ONLY on the backend.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_REQUESTS_PER_MINUTE=12
AI_DAILY_LIMIT=100

# Public instructions for the manual-payment process (do not put private credentials here).
# Example: 'حوّل إلى ... ثم اكتب رقم العملية في التطبيق'. Replace with your real instructions.
PAYMENT_INSTRUCTIONS=
# Production defaults to certificate verification. Only set false if your provider requires a deliberate insecure exception.
PGSSL_REJECT_UNAUTHORIZED=true
PG_POOL_SIZE=10
# Optional: comma-separated trusted browser origins; leave blank for native-only apps.
CORS_ORIGIN=
